{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "console",
  "rules": {
    "source_file": {
      "type": "REPEAT",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SYMBOL",
            "name": "command"
          },
          {
            "type": "SYMBOL",
            "name": "output"
          },
          {
            "type": "SYMBOL",
            "name": "blank_line"
          }
        ]
      }
    },
    "command": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "prompt",
          "content": {
            "type": "ALIAS",
            "content": {
              "type": "SYMBOL",
              "name": "_command_prompt"
            },
            "named": true,
            "value": "prompt"
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "FIELD",
              "name": "body",
              "content": {
                "type": "SYMBOL",
                "name": "command_text"
              }
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "_newline"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "continuation"
          }
        }
      ]
    },
    "continuation": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SEQ",
          "members": [
            {
              "type": "FIELD",
              "name": "body",
              "content": {
                "type": "SYMBOL",
                "name": "continuation_text"
              }
            },
            {
              "type": "SYMBOL",
              "name": "_newline"
            }
          ]
        },
        {
          "type": "ALIAS",
          "content": {
            "type": "SYMBOL",
            "name": "_continuation_newline"
          },
          "named": true,
          "value": "blank_continuation"
        }
      ]
    },
    "output": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "output_text"
        },
        {
          "type": "SYMBOL",
          "name": "_newline"
        }
      ]
    },
    "blank_line": {
      "type": "SYMBOL",
      "name": "_newline"
    }
  },
  "extras": [],
  "conflicts": [],
  "precedences": [],
  "externals": [
    {
      "type": "SYMBOL",
      "name": "_command_prompt"
    },
    {
      "type": "SYMBOL",
      "name": "command_text"
    },
    {
      "type": "SYMBOL",
      "name": "continuation_text"
    },
    {
      "type": "SYMBOL",
      "name": "output_text"
    },
    {
      "type": "SYMBOL",
      "name": "_newline"
    },
    {
      "type": "SYMBOL",
      "name": "_continuation_newline"
    }
  ],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}